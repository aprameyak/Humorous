{
  "expo": {
    "name": "Humorous",
    "slug": "humorous",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a1a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.humorous.app",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleDisplayName": "Humorous",
        "CFBundleName": "Humorous",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        },
        "UIStatusBarStyle": "UIStatusBarStyleLightContent",
        "UIViewControllerBasedStatusBarAppearance": false,

        "NSUserTrackingUsageDescription": "This app does not track users across apps or websites."
      },
      "appStoreUrl": "https://apps.apple.com/app/humorous",
      "privacyPolicyUrl": "https://humorous.app/privacy",
      "supportUrl": "https://humorous.app/support"
    },
    "android": {
      "package": "com.humorous.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFD700"
      },
      "permissions": [
        "INTERNET"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "com.humorous.app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-web-browser"
    ],
    "scheme": "com.humorous.app",
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "bd24959a-34ae-4836-9414-a1ec740f33cc"
      }
    },
    "owner": "baldmeya"
  }
}
